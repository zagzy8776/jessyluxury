'use client'

import { useState } from 'react'
import useSWR from 'swr'
import { Plus, MoreVertical, Edit, Trash2 } from 'lucide-react'
import {
  Button,
  Card,
  CardContent,
  CardHeader,
  CardTitle,
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuItem,
  DropdownMenuTrigger,
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
  Badge,
} from '@/components/ui'
import { CustomerGroup } from '@prisma/client'
import { CreateEditGroupDialog } from './_components/CreateEditGroupDialog'
import { DeleteGroupDialog } from './_components/DeleteGroupDialog'
import { toast } from 'sonner'

const fetcher = (url: string) => fetch(url).then((res) => res.json())

type CustomerGroupWithCounts = CustomerGroup & {
  _count: {
    customers: number
    priceRules: number
  }
}

export default function CustomerGroupsPage() {
  const { data: groups, error, mutate } = useSWR<CustomerGroupWithCounts[]>('/api/customer-groups', fetcher)
  const [isCreateOpen, setCreateOpen] = useState(false)
  const [editingGroup, setEditingGroup] = useState<CustomerGroupWithCounts | null>(null)
  const [deletingGroup, setDeletingGroup] = useState<CustomerGroupWithCounts | null>(null)

  const handleCreate = async (values: Partial<CustomerGroup>) => {
    const res = await fetch('/api/customer-groups', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(values),
    })
    if (res.ok) {
      toast.success('Customer group created successfully.')
      mutate()
      return true
    } else {
      const { error } = await res.json()
      toast.error(`Failed to create group: ${error}`)
      return false
    }
  }

  const handleEdit = async (id: number, values: Partial<CustomerGroup>) => {
    const res = await fetch(`/api/customer-groups/${id}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(values),
    })
    if (res.ok) {
      toast.success('Customer group updated successfully.')
      mutate()
      return true
    } else {
      const { error } = await res.json()
      toast.error(`Failed to update group: ${error}`)
      return false
    }
  }

  const handleDelete = async (id: number) => {
    const res = await fetch(`/api/customer-groups/${id}`, {
      method: 'DELETE',
    })
    if (res.ok) {
      toast.success('Customer group deleted successfully.')
      mutate()
      return true
    } else {
      const { error } = await res.json()
      toast.error(`Failed to delete group: ${error}`)
      return false
    }
  }

  if (error) return <div>Failed to load customer groups.</div>
  if (!groups) return <div>Loading...</div>

  return (
    <div className="space-y-6">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-2xl font-bold tracking-tight">Customer Groups</h1>
          <p className="text-muted-foreground">Manage wholesale, VIP, and other customer segments.</p>
        </div>
        <Button onClick={() => setCreateOpen(true)}>
          <Plus className="mr-2 h-4 w-4" /> Create Group
        </Button>
      </div>

      <Card>
        <CardHeader>
          <CardTitle>All Groups</CardTitle>
        </CardHeader>
        <CardContent>
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>Group Name</TableHead>
                <TableHead>Status</TableHead>
                <TableHead>Members</TableHead>
                <TableHead>Price Rules</TableHead>
                <TableHead className="text-right">Actions</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {groups.map((group) => (
                <TableRow key={group.id}>
                  <TableCell className="font-medium">{group.name}</TableCell>
                  <TableCell>
                    <Badge variant={group.isActive ? 'default' : 'outline'}>
                      {group.isActive ? 'ACTIVE' : 'INACTIVE'}
                    </Badge>
                  </TableCell>
                  <TableCell>{group._count.customers}</TableCell>
                  <TableCell>{group._count.priceRules}</TableCell>
                  <TableCell className="text-right">
                    <DropdownMenu>
                      <DropdownMenuTrigger asChild>
                        <Button variant="ghost" size="icon">
                          <MoreVertical className="h-4 w-4" />
                        </Button>
                      </DropdownMenuTrigger>
                      <DropdownMenuContent>
                        <DropdownMenuItem onClick={() => setEditingGroup(group)}>
                          <Edit className="mr-2 h-4 w-4" /> Edit
                        </DropdownMenuItem>
                        <DropdownMenuItem
                          className="text-destructive"
                          onClick={() => setDeletingGroup(group)}
                        >
                          <Trash2 className="mr-2 h-4 w-4" /> Delete
                        </DropdownMenuItem>
                      </DropdownMenuContent>
                    </DropdownMenu>
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </CardContent>
      </Card>

      <CreateEditGroupDialog
        isOpen={isCreateOpen || !!editingGroup}
        onClose={() => {
          setCreateOpen(false)
          setEditingGroup(null)
        }}
        onSubmit={editingGroup ? (values) => handleEdit(editingGroup.id, values) : handleCreate}
        group={editingGroup}
      />

      {deletingGroup && (
        <DeleteGroupDialog
          isOpen={!!deletingGroup}
          onClose={() => setDeletingGroup(null)}
          onConfirm={() => handleDelete(deletingGroup.id)}
          groupName={deletingGroup.name}
        />
      )}
    </div>
  )
}