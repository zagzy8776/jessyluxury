generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             Int             @id @default(autoincrement())
  name           String
  brand          String
  price          Int
  salePrice      Int?
  costPrice      Int?            @default(0)
  badge          String?
  category       Category        @relation(fields: [categoryId], references: [id])
  categoryId     Int
  volume         String          @default("100ml EDP")
  notes          String
  topNotes       String?
  middleNotes    String?
  baseNotes      String?
  description    String?
  tone           String          @default("amber")
  stock          Int             @default(10)
  reserved       Int             @default(0)
  featured       Boolean         @default(false)
  gift           Boolean         @default(false)
  images         String[]        @default([])
  orderItems     OrderItem[]
  reviews        Review[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Customer {
  id                Int                @id @default(autoincrement())
  name              String
  phone             String             @unique
  whatsapp          String
  email             String?
  city              String?
  address           String?
  totalSpent        Int                @default(0)
  ordersCount       Int                @default(0)
  notes             String?
  acquisitionSource String?            @default("Manual")
  marketingEmail    Boolean            @default(true)
  marketingWhatsapp Boolean            @default(true)
  marketingPush     Boolean            @default(true)
  orders            Order[]
  couponRedemptions CouponRedemption[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Order {
  id                       Int                  @id @default(autoincrement())
  orderNumber              String               @unique
  customer                 Customer?            @relation(fields: [customerId], references: [id])
  customerId               Int?
  customerName             String
  customerPhone            String
  customerWhatsapp         String
  shippingAddress          String?
  shippingZone             ShippingZone?        @relation(fields: [shippingZoneId], references: [id])
  shippingZoneId           Int?
  shippingFee              Int                  @default(0)
  subtotal                 Int
  discountAmount           Int                  @default(0)
  couponCode               String?
  couponDiscount           Int                  @default(0)
  couponId                 Int?
  total                    Int
  paymentStatus            String               @default("PAID") // PAID, PARTIALLY_PAID, PENDING, UNPAID, ABANDONED
  status                   String               @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  salesChannel             String               @default("Online Store") // Online Store, WhatsApp, Instagram, Physical, Other
  trackingNumber           String?
  courierName              String?
  courierPhone             String?
  waybillNotes             String?
  shippingZoneNameSnapshot String?
  estimatedDaysSnapshot    String?
  trackingToken            String?              @unique
  items                    OrderItem[]
  priceAdjustments         PriceAdjustmentLog[]
  timeline                 OrderTimeline[]
  couponRedemption         CouponRedemption?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
}

model OrderItem {
  id                  Int     @id @default(autoincrement())
  order               Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId             Int
  product             Product @relation(fields: [productId], references: [id])
  productId           Int
  quantity            Int
  price               Int // Actual unit selling price charged at sale time (may differ from product.price due to POS override)
  unitCost            Int? // Historical cost snapshot from product.costPrice at sale time; NULL if unavailable for legacy records
  productNameSnapshot String? // Product name at sale time — immutable for reliable historical reports
  brandSnapshot       String? // Brand at sale time — immutable for reliable historical reports
}

model ShippingZone {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  fee           Int
  estimatedDays String   @default("1-2 days")
  description   String?
  active        Boolean  @default(true)
  isPickup      Boolean  @default(false)
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Coupon {
  id                Int                @id @default(autoincrement())
  code              String             @unique
  name              String?
  storeLocation     String?            @default("Headquarters (Owerri)")
  discountType      String             @default("PERCENTAGE") // PERCENTAGE or FIXED
  discountValue     Int // e.g. 10 for 10% or 2000 for N2000
  minOrderAmount    Int                @default(0)
  usageLimit        Int                @default(100)
  usedCount         Int                @default(0)
  customerLimit     Int                @default(1) // Max redemptions per customer
  maxDiscountAmount Int? // Max cap for percentage discounts
  startDate         DateTime?
  endDate           DateTime?
  productIds        Int[]              @default([]) // Eligible product restrictions
  categoryIds       Int[]              @default([]) // Eligible category restrictions
  autoReactivate    Boolean            @default(true) // Auto-reactivate coupon after reaching usage limit
  isActive          Boolean            @default(true)
  redemptions       CouponRedemption[]
  campaigns         Campaign[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model CouponRedemption {
  id         Int      @id @default(autoincrement())
  couponId   Int
  customerId Int
  orderId    Int      @unique
  campaignId Int? // Direct campaign attribution tracker
  createdAt  DateTime @default(now())

  coupon   Coupon    @relation(fields: [couponId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@unique([couponId, customerId, orderId])
  @@index([couponId, customerId])
}

model Campaign {
  id          Int                @id @default(autoincrement())
  name        String
  description String?
  coupon      Coupon             @relation(fields: [couponId], references: [id])
  couponId    Int
  audience    String             @default("ALL") // ALL, VIP, INSTAGRAM_ACQUIRED, WHATSAPP_ACQUIRED, INACTIVE
  channel     String // e.g. "WhatsApp", "Instagram", "Email", "SMS"
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean            @default(true)
  redemptions CouponRedemption[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Review {
  id           Int      @id @default(autoincrement())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    Int
  customerName String
  rating       Int      @default(5)
  comment      String
  createdAt    DateTime @default(now())
}

model StoreLocation {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  address   String
  city      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaffAccount {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  role        String   @default("Manager") // Owner, Manager, Fulfillment, Catalog
  permissions String[] @default(["orders", "products"])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Expense {
  id          Int      @id @default(autoincrement())
  category    String // Packaging, Shipping, Marketing, Utility, Salary
  description String
  amount      Int
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model SystemConfig {
  id                Int      @id @default(1)
  adminPasswordHash String?
  sessionVersion    Int      @default(1)
  updatedAt         DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String // e.g. "PRODUCT_CREATED", "STOCK_ADJUSTED", "ORDER_STATUS_CHANGED", "PASSWORD_CHANGED"
  entity    String // e.g. "Product", "Order"
  entityId  String
  details   String // JSON string or descriptive text summary
  changedBy String // "Admin" or Staff Account email
  createdAt DateTime @default(now())
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int // e.g. +10, -2
  type      String // "RESERVATION_CREATED", "RESERVATION_RELEASED", "SALE", "RESTOCK", "MANUAL_ADJUSTMENT", "DAMAGE", "RETURN_RESTOCK"
  notes     String?
  changedBy String   @default("Admin")
  createdAt DateTime @default(now())
}

model PriceAdjustmentLog {
  id            Int      @id @default(autoincrement())
  orderId       Int
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     Int
  productName   String
  originalPrice Int
  customPrice   Int
  difference    Int
  changedBy     String   @default("Admin")
  reason        String?
  createdAt     DateTime @default(now())
}

model OrderTimeline {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType String // "ORDER_CREATED", "PAYMENT_UPDATED", "STATUS_CHANGED", "DISCOUNT_APPLIED", etc.
  message   String
  actorId   String   @default("Admin")
  metadata  String? // JSON string
  createdAt DateTime @default(now())
}

model Notification {
  id            Int                    @id @default(autoincrement())
  eventKey      String?                @unique // Scoped: e.g. 'order:JL-123456:shipped:ADMIN'
  type          String // e.g. 'ORDER_CREATED', 'LOW_STOCK'
  title         String
  message       String
  payload       Json?
  recipientType String                 @default("ADMIN") // "ADMIN" or "CUSTOMER"
  recipientId   Int?
  readAt        DateTime?
  archivedAt    DateTime?
  createdAt     DateTime               @default(now())
  deliveries    NotificationDelivery[]
}

model NotificationDelivery {
  id             Int       @id @default(autoincrement())
  notificationId Int
  channel        String // "IN_APP", "EMAIL", "PUSH"
  provider       String // "INTERNAL", "RESEND", "ONESIGNAL"
  status         String // "PENDING", "PROCESSING", "SENT", "FAILED", "SKIPPED"
  providerId     String?
  attempts       Int       @default(0)
  errorMessage   String?
  nextAttemptAt  DateTime? @default(now())
  claimedAt      DateTime?
  claimedBy      String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([notificationId, channel])
  @@index([status, nextAttemptAt])
}
